{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron?type=listing",
      "schedule": "50 23 * * *"
    },
    {
      "path": "/api/cron?type=subs",
      "schedule": "50 6 * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/cron",
      "dest": "/api/cron.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
